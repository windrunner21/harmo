{
       "name": "@harmo-ui/react",
       "version": "0.1.1",
       "description": "React components for Harmo: the same markup as its HTML examples, with the behavior built in.",
       "license": "MIT",
       "author": "Imran Hajiyev",
       "homepage": "https://harmo-ui.com",
       "repository": {
              "type": "git",
              "url": "git+https://github.com/windrunner21/harmo.git",
              "directory": "packages/react"
       },
       "bugs": "https://github.com/windrunner21/harmo/issues",
       "keywords": [
              "react",
              "ui",
              "components",
              "design-system"
       ],
       "type": "module",
       "files": [
              "dist",
              "src"
       ],
       "main": "./dist/cjs/index.js",
       "module": "./dist/esm/index.js",
       "types": "./dist/cjs/index.d.ts",
       "exports": {
              ".": {
                     "import": {
                            "types": "./dist/esm/index.d.ts",
                            "default": "./dist/esm/index.js"
                     },
                     "require": {
                            "types": "./dist/cjs/index.d.ts",
                            "default": "./dist/cjs/index.js"
                     },
                     "default": {
                            "types": "./dist/esm/index.d.ts",
                            "default": "./dist/esm/index.js"
                     }
              },
              "./package.json": "./package.json"
       },
       "sideEffects": false,
       "publishConfig": {
              "access": "public"
       },
       "scripts": {
              "prepack": "mise run build:react"
       },
       "peerDependencies": {
              "react": "^19.3.0",
              "react-dom": "^19.3.0"
       },
       "devDependencies": {
              "react": "19.3.0",
              "react-dom": "19.3.0",
              "@types/react": "^19",
              "@types/react-dom": "^19",
              "typescript": "^5"
       }
}
